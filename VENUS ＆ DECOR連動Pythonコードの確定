    print("===================================================================")
    print(" C@I_Press / VENUS & DECOR 連動性実証幾何代数シミュレータ 起動 ")
    print("===================================================================")
    sim = VenusDecorInterrelationSimulator()
    
    # Appleエッジデバイス（MacBook/iPhone等）でのQPU駆動シミュレーション
    # 原始(10), 空間(5), 揺らぎ(7), 予算(3) をパラレル注入
    complete, vector = sim.execute_one_shot(m=10, ui=5, ej=7, ek=3)
    
    assert complete == True
