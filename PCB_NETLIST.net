(export (version D)
  (components
    (comp (ref IC1) (value OPA810) (footprint Package_TO_SOT:SOT-23-5) (descr "Low-Noise Ultra-High Impedance FET Input OpAmp"))
    (comp (ref IC2) (value ADS8411) (footprint Package_QFP:TQFP-48) (descr "16-Bit 2MSPS High-Speed Parallel ADC"))
    (comp (ref C_REF) (value 10pF) (footprint Capacitor_SMD:C_0402_1005Metric) (descr "C_ref: Ultra-Stable COG/NPO Material Reference"))
    (comp (ref C_QBT) (value 10pF) (footprint Custom:La_HfO2_Qubit_Matrix) (descr "C_qubit: La:HfO2 Thin-Film Sample (10pF with Delta-C)"))
    (comp (ref R_F) (value 10k) (footprint Resistor_SMD:R_0402_1005Metric) (descr "R_feedback: Transimpedance Gain Resistor"))
    (comp (ref R_IN) (value 50) (footprint Resistor_SMD:R_0402_1005Metric) (descr "Impedance Matching Input Resistor"))
    (comp (ref OSC1) (value 100MHz) (footprint Oscillator:Oscillator_SMD_0503) (descr "AC Carrier Source: 100MHz Sine Output"))
  )
  (nets
    (net (code 1) (name "AC_CARRIER")
      (node (ref OSC1 pin 1))
      (node (ref C_REF pin 1))
      (node (ref C_QBT pin 1))
    )
    (net (code 2) (name "TIA_IN_INVERTING")
      (node (ref C_QBT pin 2))
      (node (ref IC1 pin 2))
      (node (ref R_F pin 1))
    )
    (net (code 3) (name "TIA_IN_NON_INVERTING")
      (node (ref C_REF pin 2))
      (node (ref IC1 pin 3))
      (node (ref R_IN pin 1))
    )
    (net (code 4) (name "TIA_OUT_DIFF")
      (node (ref IC1 pin 1))
      (node (ref R_F pin 2))
      (node (ref IC2 pin 1))
    )
    (net (code 5) (name "GND")
      (node (ref OSC1 pin 2))
      (node (ref R_IN pin 2))
      (node (ref IC1 pin 4))
      (node (ref IC2 pin 2))
    )
  )
)
